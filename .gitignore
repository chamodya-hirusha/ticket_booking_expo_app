# Node modules
node_modules/

# Expo
.expo/
dist/
web-build/

# Native builds
# If you are using Expo Prebuild (ejected-like state), these folders are usually generated.
# If you are making manual changes to native code, you might want to remove these from .gitignore.
# However, for most Expo projects using EAS Build or local prebuild, they are ignored.
android/
ios/
*.apk
*.aab
*.ipa

# Metro / Packager
.metro/
metro-cache/

# EAS (Expo Application Services)
.eas/
eas-build-pre-install.sh
eas-build-post-install.sh

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-specific junk files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# TypeScript
*.tsbuildinfo
